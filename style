*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#f5f5f5;
color:#333;
}

header{
background:#0077cc;
color:white;
padding:30px;
text-align:center;
}

nav{
margin-top:20px;
}

nav a{
color:white;
text-decoration:none;
margin:15px;
font-weight:bold;
}

nav a:hover{
text-decoration:underline;
}

section{
width:90%;
max-width:1000px;
margin:auto;
padding:40px 20px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:20px;
}

table th{
background:#0077cc;
color:white;
padding:12px;
}

table td{
padding:12px;
border:1px solid #ddd;
text-align:center;
}

form{
display:flex;
flex-direction:column;
}

input,
textarea{
padding:12px;
margin-bottom:15px;
border:1px solid #ccc;
border-radius:5px;
}

button{
padding:15px;
background:#0077cc;
color:white;
border:none;
cursor:pointer;
border-radius:5px;
font-size:16px;
}

button:hover{
background:#005fa3;
}

footer{
background:#222;
color:white;
text-align:center;
padding:20px;
margin-top:40px;
}

@media(max-width:768px){

header{
padding:20px;
}

nav a{
display:block;
margin:10px;
}

table{
font-size:14px;
}

}
